# Host directory containing Ollama's blobs and manifests.
OLLAMA_MODELS_PATH=/opt/what_changes_postgresql/data/ollama/models

# UID/GID owning OLLAMA_MODELS_PATH on the VM.
OLLAMA_UID=1000
OLLAMA_GID=1000

# Django/PostgreSQL. Generate unique secrets on the VM; do not commit .env.
POSTGRES_DB=postgres_upgrade_brief
POSTGRES_USER=postgres_upgrade_brief
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_HOST=db
DATABASE_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.65.50.99
DJANGO_TIME_ZONE=Asia/Seoul
WEB_BIND_ADDRESS=10.65.50.99

# Set only after an NFS/NAS/external disk is mounted. The backup job refuses
# the VM root filesystem and non-persistent filesystems by default.
WHAT_CHANGES_BACKUP_ROOT=/mnt/what-changes-backup
WHAT_CHANGES_BACKUP_RETENTION_DAYS=35

# Optional deployment identifier written to backup metadata. If omitted, the
# web image ID is used when the deployment directory has no .git metadata.
WHAT_CHANGES_RELEASE_ID=
